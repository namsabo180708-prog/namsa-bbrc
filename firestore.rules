rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    // exists()/get()는 규칙 평가용 — 클라이언트의 admins 읽기 권한과 무관하게 동작한다.
    function isAdmin() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isSuperAdmin() {
      return isAdmin()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.role == 'super';
    }

    /**
     * Admin registry
     * - 로그인 경로: 본인 UID 문서 get 만 필요 → 반드시 isSignedIn() + uid 일치
     * - 관리자 목록(list): 관리자만 (AdminManageModal)
     * - 쓰기는 super 전용 (최초 super는 Console/Admin SDK로 시딩)
     *
     * 주의: allow read: if isAdmin() 로 두면
     * “admins를 읽어야 isAdmin인데, isAdmin이어야 읽음” 순환으로 로그인이 깨진다.
     */
    match /admins/{uid} {
      allow get: if isSignedIn() && request.auth.uid == uid;
      allow list: if isAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // Public content collections
    match /heroSlides/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /siteSettings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /pastorGreeting/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /annualMotto/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aboutTabs/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aboutChurch/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /aboutPastor/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /staffMembers/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /worshipSchedule/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /educationDepartments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /missions/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /contactInfo/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /sitePopups/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // News: published posts public; drafts admin-only; write admin-only
    match /newsPosts/{id} {
      allow read: if resource.data.isPublished == true || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasAll(['title', 'contentHtml', 'isPublished', 'authorUid', 'createdAt'])
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // 남경기노회 문서함: 완전 비공개 — 관리자만 read/write
    match /presbyteryDocuments/{id} {
      allow read, write: if isAdmin();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
